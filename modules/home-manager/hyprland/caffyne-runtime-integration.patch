+class WifiConnectRequest:
+    """Own one nmcli child, one NM handler, and one completion callback."""
+
+    def __init__(self, device, callback, timeout_ms: int = 30_000):
+        self._device = device
+        self._callback = callback
+        self._process = None
+        self._completed = False
+        self._cancelled = False
+        self._terminal = None
+        self._poll_source = None
+        self._kill_source = None
+        self._handler = device.connect("state-changed", self._on_state_changed)
+        self._timeout_source = GLib.timeout_add(timeout_ms, self._on_timeout)
+
+    def start(self, argv) -> None:
+        try:
+            self._process = subprocess.Popen(
+                argv,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+            )
+        except OSError:
+            self._complete(False, "Failed to start NetworkManager connection")
+            return
+        self._poll_source = GLib.timeout_add(100, self._poll_child)
+
+    def _on_state_changed(self, _device, new_state, _old_state, reason):
+        if self._completed or self._cancelled:
+            return
+        state = NM.DeviceState(new_state)
+        if state == NM.DeviceState.ACTIVATED:
+            self._terminal = (True, "Connected")
+        elif state in (NM.DeviceState.FAILED, NM.DeviceState.DISCONNECTED, NM.DeviceState.NEED_AUTH):
+            reason_str = NM.DeviceStateReason(reason).value_nick
+            message = "Wrong password" if state == NM.DeviceState.NEED_AUTH or "secret" in reason_str or "auth" in reason_str else f"Failed ({reason_str})"
+            self._terminal = (False, message)
+        # This handler only records; completion belongs to _poll_child (or
+        # cancel/timeout). Signals are dispatched from the same main loop but
+        # are not ordered against the child's exit, so completing here would
+        # let a queued intermediate failure (the DISCONNECTED hop emitted
+        # while switching networks) end a request whose nmcli has already
+        # exited 0. The poll tick that owns completion is at most 100 ms
+        # behind the exit and decides from the exit code instead.
+
+    def _poll_child(self):
+        if self._completed:
+            return False
+        returncode = self._process.poll()
+        if returncode is None:
+            return True
+        self._poll_source = None
+        # The exit code is authoritative once the child is gone. nmcli only
+        # exits 0 after NetworkManager reports the activation finished, so a
+        # stored failure at that point is a stale intermediate transition
+        # (e.g. the DISCONNECTED hop NM emits when switching networks) whose
+        # ACTIVATED follow-up lost the race with the child's exit. The
+        # stored tuple is kept only to give non-zero exits a more precise
+        # message ("Wrong password") than the generic fallback. Every branch
+        # completes: returning without completing here would orphan the
+        # request until the 30 s timeout, since this poll source never
+        # re-arms after the child has exited.
+        if self._cancelled:
+            self._complete(False, "Cancelled")
+        elif returncode == 0:
+            self._complete(True, "Connected")
+        elif self._terminal and not self._terminal[0]:
+            self._complete(*self._terminal)
+        else:
+            self._complete(False, "NetworkManager connection failed")
+        return False
+
+    def _stop_child(self):
+        if self._process and self._process.poll() is None:
+            self._process.terminate()
+            if self._kill_source is None:
+                self._kill_source = GLib.timeout_add(1_000, self._force_kill)
+
+    def _force_kill(self):
+        self._kill_source = None
+        if self._process and self._process.poll() is None:
+            self._process.kill()
+        return False
+
+    def _on_timeout(self):
+        self._timeout_source = None
+        self._terminal = (False, "Connection timed out")
+        self._stop_child()
+        if not self._process or self._process.poll() is not None:
+            self._complete(*self._terminal)
+        return False
+
+    def cancel(self) -> None:
+        if self._completed or self._cancelled:
+            return
+        self._cancelled = True
+        self._terminal = (False, "Cancelled")
+        self._stop_child()
+        if not self._process or self._process.poll() is not None:
+            self._complete(*self._terminal)
+
+    def _complete(self, success: bool, message: str) -> None:
+        if self._completed:
+            return
+        self._completed = True
+        for source_name in ("_poll_source", "_timeout_source", "_kill_source"):
+            source = getattr(self, source_name)
+            if source is not None:
+                GLib.source_remove(source)
+                setattr(self, source_name, None)
+        try:
+            self._device.disconnect(self._handler)
+        except Exception:
+            pass
+        callback, self._callback = self._callback, None
+        callback(success, message)
+
