+def _awww_ready(timeout: float = 5.0) -> bool:
+    """Wait briefly for the systemd-owned awww daemon to accept requests."""
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        try:
+            result = subprocess.run(
+                ["awww", "query"],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=1,
+                check=False,
+            )
+        except FileNotFoundError:
+            # awww is missing from PATH entirely; waiting cannot help.
+            return False
+        except subprocess.TimeoutExpired:
+            # A slow first query is the cold-start case this loop exists for.
+            # Keep polling until the deadline instead of giving up on it.
+            continue
+        if result.returncode == 0:
+            return True
+        time.sleep(0.1)
+    return False
+
