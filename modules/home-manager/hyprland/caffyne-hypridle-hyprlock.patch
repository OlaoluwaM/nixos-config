+        # self.active above only runs once, at construction, so an external
+        # change to hypr-shell-caffeine.service afterwards (a session-target
+        # restart, the shared hypr-shell-caffeine script, a manual
+        # `systemctl --user stop`) would otherwise leave this tile stale for
+        # the life of the shell. Refresh it every time the Quick Settings
+        # panel is opened instead, using GTK's "map" signal.
+        #
+        # Confirmed "map" is the right hook (rather than needing a
+        # notify::visible fallback on the toplevel) with a standalone GTK3
+        # test: a Gtk.EventBox nested inside a Gtk.Window fires "map"/"unmap"
+        # every time the *window's* show()/hide() is toggled, even though the
+        # EventBox's own `visible` property never changes. That matches how
+        # this panel actually works -- bar.py's AppletWindow is a real
+        # PopupWindow toggled with genuine GTK show()/hide(), while
+        # snippets/applet_reveal.py's AppletReveal only fakes the open/close
+        # animation by painting a cached surface (it calls show_all() once in
+        # __init__ and never unmaps its children itself). So this button gets
+        # mapped/unmapped by the window's real visibility, not by the
+        # revealer, and "map" fires on every panel open as intended.
+        self.connect("map", lambda *_: setattr(self, "active", _unit_is_active()))
+
+    def _set_caffeine(self, enabled: bool) -> None:
+        action = "start" if enabled else "stop"
+        try:
+            result = subprocess.run(
+                ["systemctl", "--user", action, CAFFEINE_UNIT],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=5,
+                check=False,
+            )
+        except (OSError, subprocess.TimeoutExpired):
+            return
+        if result.returncode == 0:
+            self.active = _unit_is_active()
